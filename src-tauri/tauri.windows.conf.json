{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Biyan",
        "width": 1200,
        "minWidth": 1024,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": false,
        "center": true,
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "decorations": false,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": ["fullScreenUI", "mica", "tabbed", "blur", "acrylic"],
          "state": "active"
        },
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis", "msi"],
    "resources": [
      "resources/LICENSE",
      "resources/bin/mita-cli.exe",
      "resources/computer-agent-runner/**/*",
      "resources/bin/mita-web-research-mcp.mjs",
      "resources/embedding-models/**/*",
      "resources/pre-install/**/*",
      "resources/ms-playwright/**/*",
      "resources/node_modules/playwright/**/*",
      "resources/node_modules/playwright-core/**/*"
    ],
    "externalBin": ["resources/bin/bun", "resources/bin/uv"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "template": "windows/wix/main.wxs"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
